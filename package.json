{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.3",
  "description": "DeepSeek Harness 桌面客户端（Electron 壳，自动启动/复用 DSH 后端）",
  "main": "src/main.js",
  "license": "MIT",
  "author": "DSH Desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "electron-builder install-app-deps",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "dist": "npm run prepare:backend:x64 && electron-builder --win --x64",
    "dist:dir": "npm run prepare:backend:x64 && electron-builder --win --dir --x64",
    "prepare:backend:x64": "node scripts/prepare-backend.mjs --arch x64",
    "prepare:backend:arm64": "node scripts/prepare-backend.mjs --arch arm64",
    "dist:x64": "npm run prepare:backend:x64 && electron-builder --win nsis --x64",
    "dist:arm64": "npm run prepare:backend:arm64 && electron-builder --win nsis --arm64",
    "dist:all": "npm run dist:x64 && npm run dist:arm64",
    "dist:release": "npm run prepare:backend:x64 && electron-builder --win nsis --x64 --publish never",
    "prepare:backend:lite": "node scripts/prepare-backend.mjs --no-node",
    "prepare:backend:lite:x64": "node scripts/prepare-backend.mjs --no-node --arch x64",
    "prepare:backend:lite:arm64": "node scripts/prepare-backend.mjs --no-node --arch arm64",
    "dist:lite": "npm run prepare:backend:lite:x64 && electron-builder --win nsis --x64 --config.win.artifactName=DeepSeek-Harness-Desktop-${version}-${arch}-lite.${ext} --config.portable.artifactName=DeepSeek-Harness-Desktop-${version}-${arch}-lite-portable.${ext}",
    "dist:lite:arm64": "npm run prepare:backend:lite:arm64 && electron-builder --win nsis --arm64 --config.win.artifactName=DeepSeek-Harness-Desktop-${version}-${arch}-lite.${ext} --config.portable.artifactName=DeepSeek-Harness-Desktop-${version}-${arch}-lite-portable.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron": "^43.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "artifactName": "DeepSeek-Harness-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek Harness Desktop"
    },
    "afterPack": "scripts/afterPack.js",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "InkWord01",
        "repo": "DeepSeekHarness----Desktop"
      }
    ],
    "portable": {
      "artifactName": "DeepSeek-Harness-Desktop-${version}-${arch}-portable.${ext}"
    }
  }
}